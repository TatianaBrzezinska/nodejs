query ExampleQuery {
  users(limit: 3, firstName: "Bryan", lastName: "Smith") {
    firstName
    lastName
    countryCode
    country {
      name
    }
    company {
      name
      country {
        iso3
      }
    }
  }
  countries(iso2: "US") {
    iso3
  }
}


